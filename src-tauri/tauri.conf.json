{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ipeenv",
  "version": "0.1.0",
  "identifier": "com.ipeenv.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ipeenv",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../config/component-catalog.conf",
      "../config/project-templates.conf"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "language": "pt-BR"
      },
      "nsis": {
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
